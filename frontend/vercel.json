{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://buildgem-final-project-worker.pxxlspace.cv/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
